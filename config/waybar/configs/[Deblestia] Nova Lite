[
{
  "name": "deblestia-nova-lite",
  "include": [
    "$HOME/.config/waybar/ModulesWorkspaces",
    "$HOME/.config/waybar/Modules",
    "$HOME/.config/waybar/ModulesCustom"
  ],
  "layer": "top",
  "position": "top",
  "height": 46,
  "exclusive": true,
  "fixed-center": false,
  "ipc": true,
  "spacing": 6,
  "margin-top": 7,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": [
    "group/identity",
    "group/workspace-strip",
    "group/launchers"
  ],
  "modules-center": ["group/media-player"],
  "modules-right": [
    "group/focus",
    "group/system-monitor",
    "group/tools",
    "group/status",
    "group/session"
  ],

  "group/identity": {
    "orientation": "inherit",
    "modules": ["custom/debian-menu", "hyprland/window"]
  },
  "group/workspace-strip": {
    "orientation": "inherit",
    "modules": [
      "custom/workspace1", "custom/workspace2", "custom/workspace3",
      "custom/workspace4", "custom/workspace5", "custom/workspace6",
      "custom/workspace7", "custom/workspace8", "custom/workspace9",
      "custom/workspace10"
    ]
  },
  "group/launchers": {
    "orientation": "inherit",
    "modules": ["custom/terminal", "custom/files", "custom/browser", "wlr/taskbar"]
  },
  "group/media-player": {
    "orientation": "inherit",
    "modules": [
      "custom/cava_mviz", "custom/media-previous", "mpris", "custom/media-play-pause",
      "custom/media-next"
    ]
  },
  "group/focus": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 280,
      "children-class": "nova-drawer"
    },
    "modules": ["custom/focus", "custom/notes"]
  },
  "group/system-monitor": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 280,
      "children-class": "nova-drawer"
    },
    "modules": ["custom/overview", "cpu", "memory", "temperature", "disk"]
  },
  "group/tools": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 280,
      "children-class": "nova-drawer"
    },
    "modules": [
      "custom/toolbox", "custom/theme", "custom/screenshot", "custom/clipboard",
      "custom/hyprpicker", "custom/wallpaper"
    ]
  },
  "group/status": {
    "orientation": "inherit",
    "modules": [
      "idle_inhibitor", "privacy", "backlight", "pulseaudio",
      "network", "bluetooth", "power-profiles-daemon", "battery",
      "custom/updates", "custom/notifications", "tray"
    ]
  },
  "group/session": {
    "orientation": "inherit",
    "modules": ["clock", "custom/power"]
  },

  "custom/debian-menu": {
    "format": "",
    "tooltip-format": "Deblestia · Milieu : layouts · Droit : Bar/Nova",
    "on-click": "pkill rofi || rofi -show drun -theme $HOME/.config/rofi/DebianGlass.rasi",
    "on-click-middle": "$HOME/.config/hypr/scripts/WaybarLayout.sh",
    "on-click-right": "$HOME/.config/waybar/deblestia-waybar-switch.sh"
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 22,
    "separate-outputs": true,
    "rewrite": {
      "": "Bureau",
      "(.*) — Mozilla Firefox": "  $1",
      "(.*) - (kitty|zsh|fish)": "  $1"
    }
  },
  "custom/workspace1": {"exec": "$HOME/.config/waybar/workspace-label.sh 1", "return-type": "json", "interval": 1, "on-click": "hyprctl dispatch workspace 1", "on-scroll-up": "hyprctl dispatch workspace -1", "on-scroll-down": "hyprctl dispatch workspace +1"},
  "custom/workspace2": {"exec": "$HOME/.config/waybar/workspace-label.sh 2", "return-type": "json", "interval": 1, "on-click": "hyprctl dispatch workspace 2", "on-scroll-up": "hyprctl dispatch workspace -1", "on-scroll-down": "hyprctl dispatch workspace +1"},
  "custom/workspace3": {"exec": "$HOME/.config/waybar/workspace-label.sh 3", "return-type": "json", "interval": 1, "on-click": "hyprctl dispatch workspace 3", "on-scroll-up": "hyprctl dispatch workspace -1", "on-scroll-down": "hyprctl dispatch workspace +1"},
  "custom/workspace4": {"exec": "$HOME/.config/waybar/workspace-label.sh 4", "return-type": "json", "interval": 1, "on-click": "hyprctl dispatch workspace 4", "on-scroll-up": "hyprctl dispatch workspace -1", "on-scroll-down": "hyprctl dispatch workspace +1"},
  "custom/workspace5": {"exec": "$HOME/.config/waybar/workspace-label.sh 5", "return-type": "json", "interval": 1, "on-click": "hyprctl dispatch workspace 5", "on-scroll-up": "hyprctl dispatch workspace -1", "on-scroll-down": "hyprctl dispatch workspace +1"},
  "custom/workspace6": {"exec": "$HOME/.config/waybar/workspace-label.sh 6", "return-type": "json", "interval": 1, "on-click": "hyprctl dispatch workspace 6", "on-scroll-up": "hyprctl dispatch workspace -1", "on-scroll-down": "hyprctl dispatch workspace +1"},
  "custom/workspace7": {"exec": "$HOME/.config/waybar/workspace-label.sh 7", "return-type": "json", "interval": 1, "on-click": "hyprctl dispatch workspace 7", "on-scroll-up": "hyprctl dispatch workspace -1", "on-scroll-down": "hyprctl dispatch workspace +1"},
  "custom/workspace8": {"exec": "$HOME/.config/waybar/workspace-label.sh 8", "return-type": "json", "interval": 1, "on-click": "hyprctl dispatch workspace 8", "on-scroll-up": "hyprctl dispatch workspace -1", "on-scroll-down": "hyprctl dispatch workspace +1"},
  "custom/workspace9": {"exec": "$HOME/.config/waybar/workspace-label.sh 9", "return-type": "json", "interval": 1, "on-click": "hyprctl dispatch workspace 9", "on-scroll-up": "hyprctl dispatch workspace -1", "on-scroll-down": "hyprctl dispatch workspace +1"},
  "custom/workspace10": {"exec": "$HOME/.config/waybar/workspace-label.sh 10", "return-type": "json", "interval": 1, "on-click": "hyprctl dispatch workspace 10", "on-scroll-up": "hyprctl dispatch workspace -1", "on-scroll-down": "hyprctl dispatch workspace +1"},
  "custom/terminal": {"format": "", "tooltip-format": "Terminal", "on-click": "kitty"},
  "custom/files": {"format": "", "tooltip-format": "Fichiers", "on-click": "thunar"},
  "custom/browser": {"format": "", "tooltip-format": "Navigateur", "on-click": "firefox"},

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 17,
    "all-outputs": false,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": []
  },

  "mpris": {
    "interval": 1,
    "format": "{player_icon}  {dynamic}",
    "format-paused": "{status_icon}  {dynamic}",
    "dynamic-order": ["artist", "title"],
    "dynamic-len": 24,
    "on-click": "$HOME/.config/waybar/media-panel-toggle.sh",
    "on-click-middle": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "tooltip-format": "{artist} — {title}\nClic : panneau multimédia",
    "player-icons": {"default": "", "firefox": "", "spotify": "", "vlc": "󰕼"},
    "status-icons": {"paused": "󰐎", "playing": "", "stopped": ""}
  },
  "custom/media-previous": {"format": "󰒮", "tooltip-format": "Précédent", "on-click": "playerctl previous"},
  "custom/media-play-pause": {
    "exec": "sh -c 'case $(playerctl status 2>/dev/null) in Playing) printf 󰏤;; *) printf 󰐊;; esac'",
    "interval": 1,
    "tooltip-format": "Lecture / pause",
    "on-click": "playerctl play-pause"
  },
  "custom/media-next": {"format": "󰒭", "tooltip-format": "Suivant", "on-click": "playerctl next"},

  "custom/focus": {
    "exec": "$HOME/.config/waybar/deblestia-focus.py",
    "return-type": "json",
    "interval": 1,
    "on-click": "$HOME/.config/waybar/deblestia-focus.py toggle",
    "on-click-middle": "$HOME/.config/waybar/deblestia-focus.py skip",
    "on-click-right": "$HOME/.config/waybar/deblestia-focus.py reset"
  },
  "custom/notes": {
    "format": "󰎞",
    "tooltip-format": "Notes et tâches locales",
    "on-click": "$HOME/.config/waybar/deblestia-notes.sh"
  },

  "custom/overview": {
    "format": "󰍛",
    "tooltip-format": "Survol : performances · Clic : btop",
    "on-click": "$HOME/.config/waybar/deblestia-bar-stats.sh"
  },
  "cpu": {"interval": 2, "format": " {usage}%", "tooltip-format": "Processeur : {usage}%"},
  "memory": {"interval": 5, "format": " {percentage}%", "tooltip-format": "Mémoire : {used:0.1f}/{total:0.1f} Gio"},
  "temperature": {"interval": 5, "format": " {temperatureC}°", "critical-threshold": 85},
  "disk": {"interval": 30, "path": "/", "format": "󰋊 {percentage_used}%", "tooltip-format": "Disque : {used}/{total}"},

  "custom/toolbox": {"format": "󰒓", "tooltip-format": "Survol : outils rapides"},
  "custom/theme": {
    "format": "󰏘",
    "tooltip-format": "Changer instantanément la palette Nova",
    "on-click": "$HOME/.config/waybar/deblestia-theme.sh"
  },
  "custom/screenshot": {
    "format": "󰹑",
    "tooltip-format": "Clic : copier une zone · Clic droit : enregistrer",
    "on-click": "grim -g \"$(slurp)\" - | wl-copy",
    "on-click-right": "mkdir -p $HOME/Pictures/Screenshots && grim -g \"$(slurp)\" $HOME/Pictures/Screenshots/$(date +%F_%H-%M-%S).png"
  },
  "custom/clipboard": {
    "format": "󰅌",
    "tooltip-format": "Historique du presse-papiers",
    "on-click": "cliphist list | rofi -dmenu -i -p Presse-papiers | cliphist decode | wl-copy"
  },
  "custom/hyprpicker": {
    "format": "",
    "tooltip-format": "Copier une couleur",
    "on-click": "hyprpicker | wl-copy"
  },
  "custom/wallpaper": {
    "format": "󰸉",
    "tooltip-format": "Fonds vidéo · Clic droit : aléatoire",
    "on-click": "$HOME/.local/bin/mpvpaper-engine-toggle",
    "on-click-right": "$HOME/.local/bin/mpvpaper-enginectl random"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {"activated": "", "deactivated": ""},
    "tooltip-format-activated": "Veille suspendue",
    "tooltip-format-deactivated": "Autoriser la veille"
  },
  "privacy": {
    "icon-spacing": 4,
    "icon-size": 14,
    "transition-duration": 250,
    "modules": [
      {"type": "screenshare", "tooltip": true},
      {"type": "audio-in", "tooltip": true},
      {"type": "video-in", "tooltip": true}
    ]
  },
  "backlight": {
    "format": "{icon}",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "tooltip-format": "Luminosité {percent}%",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-bluetooth": "󰂰 {icon}",
    "format-muted": "󰖁",
    "format-icons": {"headphone": "", "default": ["", "", ""]},
    "tooltip-format": "{desc} · {volume}%",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume -l 1.2 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "network": {
    "interval": 2,
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid} · {signalStrength}%\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "on-click": "kitty -e nmtui"
  },
  "bluetooth": {
    "format": "",
    "format-connected": "󰂱 {num_connections}",
    "format-disabled": "󰂲",
    "tooltip-format": "Bluetooth : {status}",
    "on-click": "blueman-manager"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {"default": "", "performance": "", "balanced": "", "power-saver": ""},
    "tooltip-format": "Profil énergie : {profile}",
    "on-click": "$HOME/.config/waybar/power-profile-menu.sh"
  },
  "battery": {
    "states": {"warning": 30, "critical": 15},
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "Batterie {capacity}% · {timeTo}"
  },
  "custom/updates": {
    "exec": "$HOME/.config/waybar/deblestia-updates.sh",
    "return-type": "json",
    "interval": 21600,
    "signal": 8,
    "on-click": "kitty -e bash -lc 'sudo apt update && sudo apt upgrade; printf \"\\nEntrée pour fermer…\"; read -r'"
  },
  "custom/notifications": {
    "format": "",
    "tooltip-format": "Notifications · Clic droit : ne pas déranger",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw"
  },
  "tray": {"icon-size": 15, "spacing": 5},
  "clock": {
    "interval": 1,
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b · %H:%M:%S}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "custom/power": {
    "format": "",
    "tooltip-format": "Session et alimentation",
    "on-click": "$HOME/.config/hypr/scripts/Wlogout.sh"
  }
}
]
